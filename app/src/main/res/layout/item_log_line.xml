<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="3dp"
    android:paddingEnd="10dp"
    android:paddingBottom="3dp">

    <TextView
        android:id="@+id/tv_log_line"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/jetbrains_mono"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/sandrix_text_primary"
        android:textSize="11.5sp" />

    <ImageView
        android:id="@+id/iv_log_jump"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@string/action_jump_to_error_line"
        android:src="@drawable/ic_arrow_outward"
        android:visibility="gone"
        app:tint="@color/sandrix_amber" />
</LinearLayout>
